[app]
title = Mevira Keep
package.name = mevirakeep
package.domain = org.mevira
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET

android.api = 30
android.minapi = 21
android.sdk = 30
android.ndk = 23b

[buildozer]
log_level = 2
warn_on_root = 1
